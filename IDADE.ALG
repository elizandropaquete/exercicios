algoritmo "idade"
// Disciplina   : [Linguagem e Lógica de Programação] 
// Professor   : Antonio Carlos Nicolodi 
var
ano_atu, ano_nasc, idade:inteiro

inicio
      escreval("Em que ano nos estamos?")
      leia(ano_atu)
      escreval("Qual é a minha data de aniversario?")
      leia(ano_nasc)
       idade <- ano_atu-ano_nasc
       escreval("Minha idade será", idade)
fimalgoritmo
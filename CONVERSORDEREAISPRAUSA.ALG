algoritmo "ConversorDeReaisPraUsa"
var
 C,Q:inteiro
 R,D:real
inicio
      C <- 1
      escreval("Quantas vezes queres converter? ")
      leia(Q)
     enquanto (C <= Q) faca
     escreval(" Qual é o valor em R$:")
     leia (R)
     D <- R / 2.20
     escreval("O valor conertido em US$ " , D)
     C <- c + 1
     fimenquanto
fimalgoritmo
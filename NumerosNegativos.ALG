algoritmo "semnome"
var
N,C,TotN:inteiro
inicio
      C <-1
      TotN <-0
      Repita
       escreval("Digite um numero :")
       leia(N)

       TotN < TotN + 1
       fimse
       C <- C + 1
       ate(cont > 5)
       escreval("Foram digitados" , T o t N , " V a l o r e s N e g a t i v")

fimalgoritmo